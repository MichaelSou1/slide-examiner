# Secrets / local API config
.env

# Python
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
build/
dist/

# 测试与类型缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/
env/

# 实验大文件和可再生中间产物默认不入库；训练/评测报告与日志除外
runs/*
!runs/rendered/
runs/rendered/*
!runs/rendered/.gitkeep
!runs/probe/
runs/probe/*
!runs/probe/.gitkeep
models/
# reports/ 下的所有训练报告和评测报告均需纳入 Git 追踪
!reports/
!reports/**
data/raw/*
data/ir/*
data/manifests/*
!data/raw/.gitkeep
!data/ir/.gitkeep
!data/manifests/.gitkeep
# pilot/part1 manifests are regenerated from scripts/ + base decks; keep only the decks
data/pilot/*.jsonl
data/part1/*.jsonl
data/part1_img/*.jsonl
# part2: keep base decks + small composition json; drop heavy regenerable manifests/sft
data/part2/*.jsonl
!data/part2/*.jsonl
data/part2/shards/
data/part2/sft/*.jsonl
data/derisk/
*.log

# 研究运行日志必须纳入 Git；嵌套目录（如 paper/）可继续忽略纯构建日志
runs/**/*
!runs/**/
!runs/**/*.log
# D3 正式训练/评测的小型可审计产物入库；adapter、checkpoint 和 *.pt 仍保持忽略
!runs/part3/d3_formal_v2/**/*.json
!runs/part3/d3_formal_v2/**/*.jsonl
!runs/part3/d3_smoke_v2/**/*.json
!runs/part3/d3_smoke_v2/**/*.jsonl
!logs/
!logs/**

# Restored historical Part 2 v2 evidence is intentionally versioned.
!runs/part2/
runs/part2/*
!runs/part2/*.log
!runs/part2/examiner_lora_v2/
runs/part2/examiner_lora_v2/*
!runs/part2/examiner_lora_v2/*.json
!runs/part2/examiner_lora_v2/*.jsonl
!runs/part2/examiner_lora_v2/*.jinja
!runs/part2/examiner_lora_v2/*.png
!runs/part2/examiner_merged_v2/
runs/part2/examiner_merged_v2/*
!runs/part2/examiner_merged_v2/*.json
!runs/part2/examiner_merged_v2/*.txt
!runs/probe/part2_eval/
!runs/probe/part2_eval/**

# 编辑器/系统
.DS_Store
.idea/
.vscode/
data/part1_fc/*.jsonl
# part3: task sets + rendered rollouts are regenerable; keep code + reports only
data/part3/*.jsonl
data/part3/tasks/*.jsonl
data/part3/**/*.jsonl
data/part3/**/*.png
data/part3/**/*.pptx

# scratch / experiments not for the repo
playground/

# Part 3 reference papers (external arxiv PDFs, kept local for verification, not committed)
docs/refs/
docs/*.pdf

# part3 real-deck render intermediates: keep only the lossless ir/*.json oracle
data/part3/**/*.pdf
data/part3/**/lo_prof/

# AAAI-27 submission (AuthorKit27/)
# Keep only our submission/ sources + deliverables; ignore the official template
# assets shipped in the kit and all LaTeX build intermediates.
AuthorKit27/AnonymousSubmission2027.*
AuthorKit27/CameraReady2027.*
AuthorKit27/Figures/
AuthorKit27/Word/
AuthorKit27/Instructions.txt
AuthorKit27/Code and Data Supplement.txt
AuthorKit27/Technical Supplement.txt
AuthorKit27/aaai2027.bib
AuthorKit27/aaai2027.bst
AuthorKit27/aaai2027.sty
AuthorKit27/ReproducibilityChecklist.pdf
AuthorKit27/ReproducibilityChecklist.tex
# LaTeX build intermediates under submission/
AuthorKit27/submission/*.aux
AuthorKit27/submission/*.bbl
AuthorKit27/submission/*.blg
AuthorKit27/submission/*.out
# code_data_supplement/ is the unzipped source of code_data_supplement.zip; keep zip only
AuthorKit27/submission/code_data_supplement/
